        // Numerical Integration using Simpson's Rule
        function simpsonsRule(f, a, b, n = 200) {
            if (n % 2 !== 0) n++; // Ensure n is even
            const h = (b - a) / n;
            let sum = f(a) + f(b);

            for (let i = 1; i < n; i++) {
                const x = a + i * h;
                sum += i % 2 === 0 ? 2 * f(x) : 4 * f(x);
            }
            return (h / 3) * sum;
        }

